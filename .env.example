# ── Database ──────────────────────────────────────────────────────
# Used for local development (npm run dev) — NOT used by Docker
DATABASE_URL="postgresql://postgres:1234@localhost:5432/mini_payout_v2"

# Password for the Postgres container — can be any value
# docker-compose uses this for both the DB container and the app connection
DB_PASSWORD=1234

# ── Auth ──────────────────────────────────────────────────────────
# Must be at least 32 characters
JWT_SECRET="replace-this-with-a-long-random-string-min-32-chars"
WEBHOOK_SECRET="replace-this-with-a-long-random-string-min-32-chars"

# ── App ───────────────────────────────────────────────────────────
PORT=5005

# ── Redis (local dev only — Docker handles this automatically) ────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379